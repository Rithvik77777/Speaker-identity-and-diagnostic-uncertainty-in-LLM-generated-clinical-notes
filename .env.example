# Copy this file to .env (same folder) and put your real keys in .env.
# .env is git-ignored. Never commit real keys, never paste them into notebooks or issues.
# The runner refuses to start if the key for the chosen model is missing or still a placeholder.

ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
